# Copie para .env e preencha todos os campos antes de subir o overlay de produção.
APP_ENV=production
SESSION_SECURE=true
APP_URL=https://trace.example.com
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MYSQL_DATABASE=trace
MYSQL_USER=trace
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
TRACE_DEVICE_TOKEN=
CAMERA_DEVICE_TOKEN=
TRACE_ALLOWED_DEVICE_HOSTS=
TRACE_ALLOWED_DEVICE_PORTS=502
TRACE_VERSION=
TRACE_COMMIT=
LOGIN_EMAIL_DOMAIN=example.com
LOGIN_EMAIL_BASE_DOMAIN=dallogix
