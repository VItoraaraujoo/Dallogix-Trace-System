<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dallogix.trace.sync-master</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__TRACE_ROOT__/scripts/sync_master_local.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TRACE_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TRACE_GITHUB_REMOTE</key>
    <string>origin</string>
    <key>TRACE_GITHUB_BLOCK_ACTIVE</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__TRACE_ROOT__/armazenamento/logs/sync-master.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__TRACE_ROOT__/armazenamento/logs/sync-master.launchd.log</string>
</dict>
</plist>
