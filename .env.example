APP_ENV=local
TZ=America/Sao_Paulo
SESSION_SECURE=false
# O PC industrial não recebe conexões externas; o gerenciamento remoto usa o servidor central.
WEB_BIND_ADDRESS=127.0.0.1
# Serviços técnicos permanecem apenas no PC industrial.
BIND_ADDRESS=127.0.0.1
APP_URL=http://localhost
MYSQL_DATABASE=trace_local
MYSQL_USER=trace
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
SYNC_REMOTE_URL=
SYNC_REMOTE_TOKEN=
UPDATE_MANIFEST_URL=
UPDATE_MANIFEST_TOKEN=
UPDATE_PUBLIC_KEY_FILE=
UPDATE_CHANNEL=stable
CAMERA_INTERNAL_TOKEN=change-me-camera-token
PLC_INTERNAL_TOKEN=change-me-plc-token
LOGIN_EMAIL_DOMAIN=dallogix.local
CAMERA_CAPTURE_URL=
IMAGE_RETENTION_DAYS=30
MYSQL_PORT=3306
PHP_PORT=8080
NODE_RED_PORT=1880
TRACE_MACHINE_ID=EST-001
TRACE_DEBOUNCE_MS=400
PLC_PROTOCOL=modbus-tcp
MODBUS_VIRTUAL_HOST=modbus-virtual
MODBUS_VIRTUAL_PORT=1502
PLC_IP=192.168.1.10
PLC_PORT=502
PLC_EXTERNAL_PORT=
PLC_SERIAL_PORT=/dev/ttyUSB0
PLC_BAUD_RATE=9600
PLC_DATA_BITS=7
PLC_PARITY=even
PLC_STOP_BITS=1
PLC_STATION_ID=1
SCANNER_INTERFACE=serial
SCANNER_SERIAL_PORT=/dev/ttyUSB1
SCANNER_BAUD_RATE=9600
SCANNER_TERMINATOR=CRLF
