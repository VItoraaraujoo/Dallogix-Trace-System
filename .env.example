APP_ENV=local
APP_URL=http://localhost
MYSQL_DATABASE=trace_local
MYSQL_USER=trace
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
SYNC_REMOTE_URL=
CAMERA_INTERNAL_TOKEN=change-me-camera-token
CAMERA_CAPTURE_URL=
IMAGE_RETENTION_DAYS=30
MYSQL_PORT=3306
PHP_PORT=8080
NODE_RED_PORT=1880
TRACE_MACHINE_ID=EST-001
