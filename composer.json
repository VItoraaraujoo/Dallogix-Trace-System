{
  "name": "dallogix/trace",
  "description": "Dallogix Trace industrial traceability platform",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "servidor/src/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration phpstan.neon.dist"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
